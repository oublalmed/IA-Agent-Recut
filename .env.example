# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ia_recruiter
POSTGRES_USER=ia_recruiter
POSTGRES_PASSWORD=changeme_strong_password

# Spring Boot
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=changeme_jwt_secret_min_256bits_base64
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_BUCKET_RESUMES=resumes

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbit
RABBITMQ_PASSWORD=changeme_rabbit_password
RABBITMQ_VHOST=/

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...your-key-here
ANTHROPIC_MODEL_EXTRACTION=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_MATCHING=claude-haiku-4-5-20251001

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXTAUTH_SECRET=changeme_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# Email (SMTP)
